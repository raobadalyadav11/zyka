{% comment %}
  Renders Product Specifications from Metafields
  Accepts:
  - metafield: {Object} The metafield object (e.g. product.metafields.custom.specifications)
  - format: 'lines' (Label: Value per line)
{% endcomment %}

{% if metafield != blank %}
  <div class="product-specs mt-6 border-t border-gray-200">
    <h3 class="h4 mt-6 mb-4">{{ 'products.product.specifications' | t | default: 'Specifications' }}</h3>
    <div class="specs-table w-full text-sm">
      {% assign lines = metafield.value | newline_to_br | split: '<br />' %}
      {% for line in lines %}
        {% assign parts = line | split: ':' %}
        {% if parts.size == 2 %}
          <div class="spec-row flex border-b border-gray-100 py-2">
            <div class="spec-label w-1/3 text-subdued font-medium">{{ parts[0] | strip }}</div>
            <div class="spec-value w-2/3 text-body">{{ parts[1] | strip }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}
