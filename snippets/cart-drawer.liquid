{% comment %}
  Custom Cart Drawer
  - Uses 'base.css' variables
  - Preserves 'cart.js' IDs and data attributes
{% endcomment %}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>

    <div
      class="drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {% comment %} --- HEADER --- {% endcomment %}
      <div class="drawer__header">
        <h2 class="drawer__heading h3">{{ 'sections.cart.title' | t }}</h2>
        <button
          class="drawer__close-btn"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'icon', name: 'close', class: 'w-6 h-6' %}
        </button>
      </div>

      {% comment %} --- BODY --- {% endcomment %}
      <div class="drawer__body">
        {%- if cart == empty -%}
          <div class="drawer__inner-empty text-center">
            <h2 class="h4">{{ 'sections.cart.empty' | t }}</h2>
            <a href="{{ routes.all_products_collection_url }}" class="button button--primary mt-4">
              {{ 'general.continue_shopping' | t }}
            </a>
          </div>
        {%- endif -%}

        <cart-drawer-items
          {% if cart == empty %}
            class="is-empty"
          {% endif %}
        >
          <form
            action="{{ routes.cart_url }}"
            id="CartDrawer-Form"
            class="cart-drawer__form"
            method="post"
          >
            <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
              {%- if cart != empty -%}
                <div class="drawer__cart-items-wrapper">
                  <table class="cart-items" role="table">
                    <tbody role="rowgroup">
                      {%- for item in cart.items -%}
                        <tr id="CartDrawer-Item-{{ item.index | plus: 1 }}" class="cart-item relative" role="row">
                          {% comment %} LOADING SPINNER {% endcomment %}
                          <div class="loading__spinner hidden absolute top-0 left-0 w-full h-full bg-white-50 flex items-center justify-center z-10">
                            {% render 'icon', name: 'spinner', class: 'w-6 h-6 animate-spin' %}
                          </div>

                          {% comment %} IMAGE {% endcomment %}
                          <td class="cart-item__media" role="cell">
                            {% if item.image %}
                              <img
                                class="cart-item__image rounded-theme"
                                src="{{ item.image | image_url: width: 300 }}"
                                alt="{{ item.image.alt | escape }}"
                                loading="lazy"
                                width="100"
                                height="auto"
                              >
                            {% endif %}
                          </td>

                          {% comment %} DETAILS {% endcomment %}
                          <td class="cart-item__details" role="cell">
                            <a href="{{ item.url }}" class="cart-item__name h5 block mb-1">
                              {{- item.product.title | escape -}}
                            </a>

                            {%- if item.product.has_only_default_variant == false -%}
                              <div class="text-sm text-subdued mb-2">
                                {%- for option in item.options_with_values -%}
                                  <div class="product-option">
                                    <span>{{ option.name }}: {{ option.value }}</span>
                                  </div>
                                {%- endfor -%}
                              </div>
                            {%- endif -%}

                            <div class="cart-item__price-wrapper mb-2">
                              <span class="price">
                                {{ item.final_line_price | money }}
                              </span>
                            </div>

                            {% comment %} QUANTITY & REMOVE {% endcomment %}
                            <div class="cart-item__actions flex items-center justify-between gap-4">
                              <quantity-popover>
                                <div class="quantity-wrapper flex items-center border rounded-theme">
                                  <button class="quantity__button p-2" name="minus" type="button">
                                    {% render 'icon', name: 'minus', class: 'w-3 h-3' %}
                                  </button>
                                  <input
                                    class="quantity__input w-8 text-center border-none"
                                    type="number"
                                    data-quantity-variant-id="{{ item.variant.id }}"
                                    name="updates[]"
                                    value="{{ item.quantity }}"
                                    data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                    min="0"
                                    step="1"
                                    id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                    data-index="{{ item.index | plus: 1 }}"
                                  >
                                  <button class="quantity__button p-2" name="plus" type="button">
                                    {% render 'icon', name: 'plus', class: 'w-3 h-3' %}
                                  </button>
                                </div>
                              </quantity-popover>

                              <cart-remove-button
                                id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                              >
                                <button
                                  type="button"
                                  class="text-subdued hover:text-primary text-sm underline"
                                  aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                                >
                                  Remove
                                </button>
                              </cart-remove-button>
                            </div>

                            <div
                              id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}"
                              class="cart-item__error text-red-500 text-sm mt-1"
                              role="alert"
                            >
                              <small class="cart-item__error-text"></small>
                            </div>
                          </td>
                        </tr>
                      {%- endfor -%}
                    </tbody>
                  </table>
                </div>
              {%- endif -%}
              <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
              <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
                {{ 'accessibility.loading' | t }}
              </p>
            </div>
            <div id="CartDrawer-CartErrors" role="alert" class="text-red-500 text-sm p-4"></div>
          </form>
        </cart-drawer-items>
      </div>

      {% comment %} --- FOOTER --- {% endcomment %}
      <div class="drawer__footer p-4 border-t">
        <div class="cart-drawer__footer" {{ block.shopify_attributes }}>
          <div class="totals flex justify-between items-center mb-4" role="status">
            <h2 class="totals__total h4 m-0">{{ 'sections.cart.estimated_total' | t }}</h2>
            <p class="totals__total-value h4 m-0">{{ cart.total_price | money_with_currency }}</p>
          </div>

          <small class="tax-note block text-sm text-subdued mb-4">
            {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
          </small>

          <div class="cart__ctas">
            <button
              type="submit"
              id="CartDrawer-Checkout"
              class="cart__checkout-button button button--primary w-full"
              name="checkout"
              form="CartDrawer-Form"
              {% if cart == empty %}
                disabled
              {% endif %}
            >
              {{ 'sections.cart.checkout' | t }}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</cart-drawer>
