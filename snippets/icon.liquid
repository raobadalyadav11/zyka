{% comment %}
  Renders an SVG icon.

  Accepts:
  - name: {String} Icon name (e.g. 'arrow-right', 'check')
  - class: {String} Additional classes (optional)

  Usage:
  {% render 'icon', name: 'arrow-right' %}
{% endcomment %}

<span class="icon {{ class }}" aria-hidden="true">
  {% case name %}
    {% when 'arrow-right' %}
      <svg viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.677-.093l4 3a.5.5 0 010 .8l-4 3a.5.5 0 01-.6-.8l3.057-2.292H1.5a.5.5 0 010-1h10.171L8.614 1.229a.5.5 0 01-.077-.421z" fill="currentColor"/>
      </svg>
    {% when 'check' %}
      <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" fill="currentColor"/>
      </svg>
    {% when 'close' %}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        focusable="false"
        class="icon icon-close"
        fill="none"
        viewBox="0 0 18 17"
      >
        <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor">
      </svg>
    {% when 'caret' %}
      <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-caret" viewBox="0 0 10 6">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
      </svg>
    {% else %}
      <!-- Icon not found: {{ name }} -->
  {% endcase %}
</span>
